# 复制本文件为 .env 并填写（.env 已在 .gitignore 里，不会进仓库）

# === LLM 服务（必填，OpenAI 兼容） ===
LLM_PROVIDER=deepseek-official
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# === QQ（可选，NapCat OneBot11） ===
QQ_ENABLED=false
QQ_HTTP=http://127.0.0.1:3000
QQ_SELF_ID=
QQ_ALLOW_USERS=

# === TTS（可选，需自备 GPT-SoVITS） ===
TTS_ENABLED=false
TTS_ENGINE=gpt-sovits
TTS_API=http://127.0.0.1:9880
TTS_REF_AUDIO=
TTS_PROMPT_TEXT=
